<bpmn:serviceTask id="payment" name="A_Pending"><bpmn:extensionElements><zeebe:taskDefinition type="reference_bpic2017.payment" retries="3"/></bpmn:extensionElements></bpmn:serviceTask>
<bpmn:serviceTask id="dispatch" name="O_Sent (mail and online)"><bpmn:extensionElements><zeebe:taskDefinition type="reference_bpic2017.dispatch" retries="3"/></bpmn:extensionElements></bpmn:serviceTask>
<bpmn:serviceTask id="archive" name="Archive application"><bpmn:extensionElements><zeebe:taskDefinition type="reference_bpic2017.archive" retries="3"/></bpmn:extensionElements></bpmn:serviceTask>
