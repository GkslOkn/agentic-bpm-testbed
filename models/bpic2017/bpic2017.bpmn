<bpmn:sequenceFlow id="f17" sourceRef="resume" targetRef="match"><bpmn:conditionExpression xsi:type="bpmn:tFormalExpression" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">= resumeStep = "match"</bpmn:conditionExpression></bpmn:sequenceFlow>
<bpmn:sequenceFlow id="f18" sourceRef="reserve_error" targetRef="escalation"></bpmn:sequenceFlow>
<bpmn:sequenceFlow id="f19" sourceRef="resume" targetRef="reserve"><bpmn:conditionExpression xsi:type="bpmn:tFormalExpression" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">= resumeStep = "reserve"</bpmn:conditionExpression></bpmn:sequenceFlow>
<bpmn:sequenceFlow id="f20" sourceRef="compliance_error" targetRef="escalation"></bpmn:sequenceFlow>
<bpmn:sequenceFlow id="f21" sourceRef="resume" targetRef="compliance"><bpmn:conditionExpression xsi:type="bpmn:tFormalExpression" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">= resumeStep = "compliance"</bpmn:conditionExpression></bpmn:sequenceFlow>
<bpmn:sequenceFlow id="f22" sourceRef="payment_error" targetRef="escalation"></bpmn:sequenceFlow>
